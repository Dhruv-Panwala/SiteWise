# SiteWise UK local configuration
# Copy this file to .env. Do not commit .env.

APP_ENV=development

# The supplied planning CSV is stored under Data/raw in this workspace.
PLANNING_CSV=./Data/raw/foundations_london_housing_2022_2025_20260810T013626Z.csv

PROCESSED_DIR=./data/processed
CACHE_DIR=./data/cache

# Public planning APIs
PLANNING_DATA_API=https://www.planning.data.gov.uk/entity.json
PLANNING_DATA_DATASETS=https://www.planning.data.gov.uk/dataset.json
GLA_LOCAL_PLAN_DATASET_URL=https://data.london.gov.uk/dataset/planning-local-plan-data-2zjmn
ARCGIS_SERVICES_BASE=https://services.arcgis.com/drifeOPKLpgnJ8Qa/arcgis/rest/services
# GLA public spatial queries; no API key. Independent of ENABLE_LIVE_CONSTRAINTS.
# The check_gla.py diagnostic always queries GLA and never loads .env.
ENABLE_GLA_ARCGIS=false
LONDON_DATAHUB_URL=https://planninglondondatahub.london.gov.uk/

# Public postcode/geocoding service
GEOCODER_URL=https://api.postcodes.io
GEOCODER_USER_AGENT=sitewise-uk-hackathon/0.1

# Network behaviour
REQUEST_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=86400
CONSTRAINT_GEOJSON_DIR=./data/raw/constraints
# Enable public Planning Data spatial queries for the live demo.
# The web server never reads .env: pass scripts/run_demo.py --live-constraints
# or set this variable in the same terminal process before launching the server.
ENABLE_LIVE_CONSTRAINTS=true
# Council text is independent of spatial constraints. The web demo always retrieves
# it; this switch enables it in the CLI. Pilot: Wandsworth, Westminster, Lambeth.
ENABLE_COUNCIL_POLICIES=true
# Web explanation is requested AFTER deterministic retrieval. Requires HF_TOKEN
# in the server process; run_demo.py --prompt-hf-token asks without saving it.
# The demo never reads .env. Values here document settings; they are not auto-loaded.
ENABLE_LLM_REPORTS=true

# Optional LLM provider. Hugging Face is the default hackathon path.
HF_TOKEN=
# Small, practical model for grounded planning reports.
HF_MODEL=microsoft/Phi-4-mini-instruct
HF_PROVIDER=featherless-ai
# Keep both the evidence prompt and response concise for a small model.
HF_MAX_NEARBY_CASES=4
HF_MAX_SIMILAR_CASES=3
HF_MAX_DESCRIPTION_CHARS=320
HF_MAX_INPUT_CHARS=12000
HF_MAX_NEW_TOKENS=800
HF_TEMPERATURE=0.2

# Optional alternative provider. Leave blank when using Hugging Face.
OPENAI_API_KEY=
OPENAI_MODEL=
